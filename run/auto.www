#!/bin/dash

backingfiles_root="${BACKINGFILES_ROOT:-/backingfiles}"
mountoptsforimage="${MOUNTOPTSFORIMAGE:-/root/bin/mountoptsforimage}"

case "$1" in
  Music)
    diskimage="$backingfiles_root/music_disk.bin"
    ;;
  LightShow)
    diskimage="$backingfiles_root/lightshow_disk.bin"
    ;;
  Boombox)
    diskimage="$backingfiles_root/boombox_disk.bin"
    ;;
  *)
    exit 1
    ;;
esac

optfile="${diskimage}.opts"

if [ ! -r "$diskimage" ]
then
  exit 1
fi

if [ ! -f "$optfile" ]
then
  if [ -e "$optfile" ] || [ -L "$optfile" ]
  then
    rm -f "$optfile" || exit 1
  fi

  mount_options=$("$mountoptsforimage" "$diskimage") || exit 1
  set -f
  # mountoptsforimage emits exactly two whitespace-separated fields.
  # shellcheck disable=SC2086
  set -- $mount_options
  set +f
  if [ "$#" -ne 2 ] || [ -z "$1" ] || [ -z "$2" ]
  then
    exit 1
  fi

  tmpfile=$(mktemp "${optfile}.tmp.XXXXXX") || exit 1
  trap 'rm -f "$tmpfile"' 0
  trap 'exit 1' HUP INT TERM
  printf '%s\n' "-fstype=$1,rw,$2 :${diskimage}" > "$tmpfile"
  mv -f "$tmpfile" "$optfile"
  trap - 0 HUP INT TERM
fi

cat "$optfile"
