               ;;
            esac
          done
          if command -v docker > /dev/null && sudo docker info > /dev/null 2>&1
          then
            sudo docker system prune --all --force --volumes
          fi
          sudo apt-get clean
          df -h -- "${RUNNER_TEMP}"

      - name: Install native pi-gen dependencies
        run: |
          set -euo pipefail
          sudo apt-get update
          sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y \
            arch-test bc bmap-tools coreutils curl debootstrap dosfstools \
            e2fsprogs file git gpg grep jq kmod libarchive-tools libcap2-bin \
            parted pigz qemu-user-binfmt quilt rsync util-linux xxd xz-utils \
            zerofree zip
          command -v gh > /dev/null || {
            echo "GitHub CLI is unavailable on the hosted runner" >&2
            exit 1
          }

      - name: Require at least 25 GiB free for pi-gen
        run: |
          set -euo pipefail
          available_bytes=$(df -PB1 --output=avail "${RUNNER_TEMP}" | tail -n 1 | tr -d ' ')
          minimum_bytes=$((25 * 1024 * 1024 * 1024))
          [[ "${available_bytes}" =~ ^[0-9]+$ ]] || {
            echo "Unable to determine free build space" >&2
            exit 1
          }
          if [ "${available_bytes}" -lt "${minimum_bytes}" ]
          then
            echo "pi-gen requires at least 25 GiB free; only ${available_bytes} bytes are available" >&2
            df -h -- "${RUNNER_TEMP}"
            exit 1
          fi
          df -h -- "${RUNNER_TEMP}"

      - name: Clone exact pi-gen source
        id: pigen
        run: |
          set -euo pipefail
          [[ "${PI_GEN_COMMIT}" =~ ^[0-9a-f]{40}$ ]]
          pi_gen_dir="${RUNNER_TEMP}/pi-gen"
          [ ! -e "${pi_gen_dir}" ] || {
            echo "Refusing to replace existing pi-gen path: ${pi_gen_dir}" >&2
            exit 1
          }
          git init --quiet "${pi_gen_dir}"
          git -C "${pi_gen_dir}" remote add origin https://github.com/RPi-Distro/pi-gen.git
          git -C "${pi_gen_dir}" fetch --depth=1 origin "${PI_GEN_COMMIT}"
          git -C "${pi_gen_dir}" checkout --detach "${PI_GEN_COMMIT}"
          [ "$(git -C "${pi_gen_dir}" rev-parse HEAD)" = "${PI_GEN_COMMIT}" ]
          git -C "${pi_gen_dir}" cat-file -e "${PI_GEN_COMMIT}:stage2/prerun.sh"
          [ -z "$(git -C "${pi_gen_dir}" status --porcelain=v1 --untracked-files=no)" ]
          printf 'directory=%s\n' "${pi_gen_dir}" >> "${GITHUB_OUTPUT}"

      - name: Prepare pinned TeslaUSB stage
        env:
          PI_GEN_DIR: ${{ steps.pigen.outputs.directory }}
        run: |
          set -euo pipefail
          cd "${PI_GEN_DIR}"
          "${GITHUB_WORKSPACE}/pi-gen-sources/prepare.sh"
          grep -Fx "RELEASE=trixie" config > /dev/null
          grep -F 'STAGE_LIST="stage0 stage1 stage2 stage_teslausb"' config > /dev/null

      - name: Build uncompressed arm64 image natively
        env:
          ASSET_STEM: ${{ steps.release.outputs.asset_stem }}
          IMAGE_DATE: ${{ steps.release.outputs.image_date }}
          PI_GEN_DIR: ${{ steps.pigen.outputs.directory }}
          SOURCE_EPOCH: ${{ steps.release.outputs.source_epoch }}
        run: |
          set -euo pipefail
          [ "$(uname -m)" = aarch64 ] || {
            echo "Release image must be built natively on an arm64 runner" >&2
            exit 1
          }
          build_config="${RUNNER_TEMP}/teslausb-release-config"
          printf '%s\n' \
            'DEPLOY_COMPRESSION=none' \
            "IMG_DATE=${IMAGE_DATE}" \
            "IMG_FILENAME=${ASSET_STEM}" > "${build_config}"
          chmod 0600 "${build_config}"

          cd "${PI_GEN_DIR}"
          if ! sudo env SOURCE_DATE_EPOCH="${SOURCE_EPOCH}" \
            ./build.sh -c "${build_config}"
          then
            df -h -- "${RUNNER_TEMP}" || true
            find work -name build.log -type f -print 2> /dev/null || true
            exit 1
          fi
          sudo chown -R -- "$(id -u):$(id -g)" deploy
          df -h -- "${RUNNER_TEMP}"

      - name: Verify image and create manifests
        id: assets
        env:
          ASSET_STEM: ${{ steps.release.outputs.asset_stem }}
          PI_GEN_DIR: ${{ steps.pigen.outputs.directory }}
          SOURCE_COMMIT: ${{ steps.release.outputs.source_commit }}
          SOURCE_EPOCH: ${{ steps.release.outputs.source_epoch }}
          VERSION: ${{ steps.release.outputs.version }}
        run: |
          set -euo pipefail
          dist_dir="${RUNNER_TEMP}/release-assets"
          mkdir -m 0700 -- "${dist_dir}"

          images=()
          while IFS= read -r -d '' image
          do
            images+=("${image}")
          done < <(find "${PI_GEN_DIR}/deploy" -maxdepth 1 -type f -name '*.img' -print0)
          [ "${#images[@]}" -eq 1 ] || {
            echo "Expected exactly one uncompressed pi-gen image; found ${#images[@]}" >&2
            exit 1
          }
          raw_image="${dist_dir}/${ASSET_STEM}.img"
          [ "$(basename -- "${images[0]}")" = "${ASSET_STEM}.img" ] || {
            echo "pi-gen produced an unexpected image name: ${images[0]}" >&2
            exit 1
          }
          mv -- "${images[0]}" "${raw_image}"

          packages="${dist_dir}/${ASSET_STEM}.packages.tsv"
          metadata="${dist_dir}/${ASSET_STEM}.image-metadata.json"
          bash "${GITHUB_WORKSPACE}/tools/verify-release-image.sh" \
            "${raw_image}" "${VERSION}" "${SOURCE_COMMIT}" "${PI_GEN_COMMIT}" \
            "${packages}" "${metadata}"

          raw_sha256=$(sha256sum -- "${raw_image}")
          raw_sha256=${raw_sha256%% *}
          env -u XZ_DEFAULTS -u XZ_OPT xz --threads=1 --check=crc64 \
            --lzma2=preset=6 -- "${raw_image}"
          compressed_image="${raw_image}.xz"
          [ -f "${compressed_image}" ] && [ ! -L "${compressed_image}" ]
          [ ! -e "${raw_image}" ]
          env -u XZ_DEFAULTS -u XZ_OPT xz --test -- "${compressed_image}"

          compressed_bytes=$(stat -c %s -- "${compressed_image}")
          maximum_release_bytes=$((2 * 1024 * 1024 * 1024 - 1))
          [ "${compressed_bytes}" -le "${maximum_release_bytes}" ] || {
            echo "Compressed image exceeds the 2 GiB release-asset safety limit" >&2
            exit 1
          }
          compressed_sha256=$(sha256sum -- "${compressed_image}")
          compressed_sha256=${compressed_sha256%% *}
          package_manifest_sha256=$(sha256sum -- "${packages}")
          package_manifest_sha256=${package_manifest_sha256%% *}
          build_completed_utc=$(date -u +'%Y-%m-%dT%H:%M:%SZ')

          checksum_file="${compressed_image}.sha256"
          printf '%s  %s\n' "${compressed_sha256}" \
            "$(basename -- "${compressed_image}")" > "${checksum_file}"
          chmod 0644 "${checksum_file}"
          (
            cd "${dist_dir}"
            sha256sum -c -- "$(basename -- "${checksum_file}")"
          )

          metadata_tmp=$(mktemp "${dist_dir}/.image-metadata.XXXXXXXX")
          jq -S \
            --arg image_asset "$(basename -- "${compressed_image}")" \
            --arg checksum_asset "$(basename -- "${checksum_file}")" \
            --arg package_manifest "$(basename -- "${packages}")" \
            --arg raw_image_sha256 "${raw_sha256}" \
            --arg compressed_image_sha256 "${compressed_sha256}" \
            --arg package_manifest_sha256 "${package_manifest_sha256}" \
            --arg source_epoch "${SOURCE_EPOCH}" \
            --arg build_completed_utc "${build_completed_utc}" \
            --arg runner_arch "${RUNNER_ARCH}" \
            --arg runner_image_os "${ImageOS:-unknown}" \
            --arg runner_image_version "${ImageVersion:-unknown}" \
            --arg workflow_run "${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}" \
            --arg run_attempt "${GITHUB_RUN_ATTEMPT}" \
            --arg compression 'xz --threads=1 --check=crc64 --lzma2=preset=6' \
            --arg