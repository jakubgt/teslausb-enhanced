name: Build release image

on:
  push:
    branches: [main-dev]
    paths: [VERSION]
  release:
    types: [published]
  workflow_dispatch:
    inputs:
      release_tag:
        description: Existing GitHub release tag (for example, v1.2.0 or v1.2.0-rc.1)
        required: true
        type: string

permissions:
  actions: read
  contents: write

concurrency:
  group: teslausb-release-image
  cancel-in-progress: false

jobs:
  build:
    name: Raspberry Pi Zero 2 W arm64 image
    runs-on: ubuntu-24.04-arm
    timeout-minutes: 360
    defaults:
      run:
        shell: bash
    env:
      PI_GEN_COMMIT: ca8aeed0ae300c2a89f55ce9617d5f96a27e99e5
      RELEASE_TAG: ${{ github.event.release.tag_name || inputs.release_tag || '' }}

    steps:
      - name: Check out repository history
        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Validate release tag and source
        id: release
        run: |
          set -euo pipefail

          release_tag=${RELEASE_TAG:-}
          if [ "${GITHUB_EVENT_NAME}" = push ]
          then
            [ "${GITHUB_REF}" = refs/heads/main-dev ] || {
              echo "VERSION push builds are restricted to main-dev" >&2
              exit 1
            }
            source_commit=$(git rev-parse --verify HEAD)
            [ "${source_commit}" = "${GITHUB_SHA}" ] || {
              echo "Checked-out VERSION commit does not match GITHUB_SHA" >&2
              exit 1
            }
          else
            if ! [[ "${release_tag}" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-rc\.(0|[1-9][0-9]*))?$ ]]
            then
              echo "Release tag must be vMAJOR.MINOR.PATCH or vMAJOR.MINOR.PATCH-rc.NUMBER" >&2
              exit 1
            fi
            git show-ref --verify --quiet "refs/tags/${release_tag}" || {
              echo "Release tag is not present in the fetched repository: ${release_tag}" >&2
              exit 1
            }
            source_commit=$(git rev-parse --verify "${release_tag}^{commit}")
            git checkout --detach "${source_commit}"
          fi
          [[ "${source_commit}" =~ ^[0-9a-f]{40}$ ]] || {
            echo "Unable to resolve the release tag to one commit" >&2
            exit 1
          }
          [ "$(git rev-parse HEAD)" = "${source_commit}" ]
          [ -z "$(git status --porcelain=v1 --untracked-files=no)" ] || {
            echo "Release checkout contains modified tracked files" >&2
            exit 1
          }

          mapfile -t version_lines < VERSION
          [ "${#version_lines[@]}" -eq 1 ] || {
            echo "VERSION must contain exactly one line" >&2
            exit 1
          }
          version=${version_lines[0]}
          [[ "${version}" != *$'\r'* ]] || {
            echo "VERSION must use Unix line endings" >&2
            exit 1
          }
          if [ "${GITHUB_EVENT_NAME}" = push ]
          then
            release_tag="v${version}"
          fi
          if ! [[ "${release_tag}" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-rc\.(0|[1-9][0-9]*))?$ ]]
          then
            echo "VERSION must produce vMAJOR.MINOR.PATCH or vMAJOR.MINOR.PATCH-rc.NUMBER" >&2
            exit 1
          fi
          [ "v${version}" = "${release_tag}" ] || {
            echo "VERSION (${version}) does not exactly match ${release_tag}" >&2
            exit 1
          }

          release_notes_path=".github/release-notes/${release_tag}.md"
          [ -f "${release_notes_path}" ] && [ ! -L "${release_notes_path}" ] &&
            [ -s "${release_notes_path}" ] || {
            echo "Required release notes are missing, empty, or symbolic: ${release_notes_path}" >&2
            exit 1
          }
          release_notes_mode=$(git ls-tree "${source_commit}" -- "${release_notes_path}" |
            awk 'NR == 1 { print $1 }')
          [ "${release_notes_mode}" = 100644 ] || {
            echo "Release notes must be a regular tracked 100644 file in the release commit" >&2
            exit 1
          }
          git cat-file -e "${source_commit}:${release_notes_path}"

          source_epoch=$(git show -s --format=%ct "${source_commit}")
          [[ "${source_epoch}" =~ ^[0-9]+$ ]] || {
            echo "Unable to resolve the release source timestamp" >&2
            exit 1
          }
          image_date=$(date -u --date="@${source_epoch}" +%F)
          asset_stem="teslausb-enhanced-${release_tag}-pi-zero-2w-arm64-trixie"

          printf 'RELEASE_TAG=%s\n' "${release_tag}" >> "${GITHUB_ENV}"
          {
            printf 'release_tag=%s\n' "${release_tag}"
            printf 'release_notes_path=%s\n' "${release_notes_path}"
            printf 'version=%s\n' "${version}"
            printf 'source_commit=%s\n' "${source_commit}"
            printf 'source_epoch=%s\n' "${source_epoch}"
            printf 'image_date=%s\n' "${image_date}"
            printf 'asset_stem=%s\n' "${asset_stem}"
          } >> "${GITHUB_OUTPUT}"

      - name: Require successful Validate run for VERSION push
        if: github.event_name == 'push'
        timeout-minutes: 27
        env:
          GH_TOKEN: ${{ github.token }}
          SOURCE_COMMIT: ${{ steps.release.outputs.source_commit }}
        run: |
          set -euo pipefail

          deadline=$((SECONDS + 1500))
          while (( SECONDS < deadline ))
          do
            runs=$(gh api --method GET \
              "repos/${GITHUB_REPOSITORY}/actions/workflows/shellcheck.yml/runs" \
              -f branch=main-dev \
              -f event=push \
              -f head_sha="${SOURCE_COMMIT}" \
              -F per_page=100)
            total_count=$(jq -er '.total_count' <<< "${runs}")
            [[ "${total_count}" =~ ^[0-9]+$ ]] || {
              echo "GitHub returned an invalid Validate run count" >&2
              exit 1
            }

            if [ "${total_count}" -eq 0 ]
            then
              echo "Waiting for the Validate run for ${SOURCE_COMMIT} to appear"
              sleep 15
              continue
            fi
            [ "${total_count}" -eq 1 ] || {
              echo "Expected one Validate push run for ${SOURCE_COMMIT}; found ${total_count}" >&2
              exit 1
            }

            run_count=$(jq -er '.workflow_runs | length' <<< "${runs}")
            [ "${run_count}" -eq 1 ] || {
              echo "Validate run response is incomplete or ambiguous" >&2
              exit 1
            }
            jq -e --arg source_commit "${SOURCE_COMMIT}" '
              .workflow_runs[0].head_sha == $source_commit and
              .workflow_runs[0].head_branch == "main-dev" and
              .workflow_runs[0].event == "push"
            ' <<< "${runs}" > /dev/null || {
              echo "Validate run identity does not match this VERSION push" >&2
              exit 1
            }

            run_status=$(jq -er '.workflow_runs[0].status' <<< "${runs}")
            run_url=$(jq -er '.workflow_runs[0].html_url' <<< "${runs}")
            if [ "${run_status}" = completed ]
            then
              conclusion=$(jq -er '.workflow_runs[0].conclusion' <<< "${runs}")
              [ "${conclusion}" = success ] || {
                echo "Validate did not succeed (${conclusion}): ${run_url}" >&2
                exit 1
              }
              echo "Validate succeeded: ${run_url}"
              break
            fi

            case "${run_status}" in
              queued|in_progress|pending|requested|waiting)
                echo "Validate is ${run_status}: ${run_url}"
                ;;
              *)
                echo "Unexpected Validate run status (${run_status}): ${run_url}" >&2
                exit 1
                ;;
            esac
            sleep 15
          done

          [ "${run_status:-}" = completed ] || {
            echo "Timed out waiting 25 minutes for Validate on ${SOURCE_COMMIT}" >&2
         