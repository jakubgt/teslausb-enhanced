json compressed_bytes "${compressed_bytes}" \
            '.artifact = {
                image: $image_asset,
                checksum: $checksum_asset,
                package_manifest: $package_manifest,
                raw_image_sha256: $raw_image_sha256,
                compressed_image_sha256: $compressed_image_sha256,
                package_manifest_sha256: $package_manifest_sha256,
                compressed_bytes: $compressed_bytes,
                compression: $compression
              }
              | .build = {
                source_epoch: ($source_epoch | tonumber),
                build_completed_utc: $build_completed_utc,
                runner_arch: $runner_arch,
                runner_image_os: $runner_image_os,
                runner_image_version: $runner_image_version,
                workflow_run: $workflow_run,
                run_attempt: ($run_attempt | tonumber)
              }' "${metadata}" > "${metadata_tmp}"
          mv -fT -- "${metadata_tmp}" "${metadata}"
          chmod 0644 "${metadata}" "${packages}"
          jq -e \
            '.image.architecture == "arm64" and
             .image.debian_codename == "trixie" and
             .image.first_user_locked == true and
             .image.active_setup_config_present == false and
             .artifact.compressed_image_sha256 != ""' \
            "${metadata}" > /dev/null

          for text_asset in "${checksum_file}" "${metadata}" "${packages}"
          do
            if grep -aEq \
              'github_pat_|gh[pousr]_[A-Za-z0-9_]{20,}|BEGIN [A-Z ]*PRIVATE KEY|must-not-leak' \
              "${text_asset}"
            then
              echo "Potential credential material detected in $(basename -- "${text_asset}")" >&2
              exit 1
            fi
          done
          [ -z "$(find "${dist_dir}" -maxdepth 1 -type f -name '*.img' -print -quit)" ] || {
            echo "Uncompressed image remains in the release directory" >&2
            exit 1
          }

          {
            printf 'image=%s\n' "${compressed_image}"
            printf 'checksum=%s\n' "${checksum_file}"
            printf 'metadata=%s\n' "${metadata}"
            printf 'packages=%s\n' "${packages}"
          } >> "${GITHUB_OUTPUT}"

      - name: Upload verified assets to matching release
        env:
          CHECKSUM_ASSET: ${{ steps.assets.outputs.checksum }}
          GH_TOKEN: ${{ github.token }}
          IMAGE_ASSET: ${{ steps.assets.outputs.image }}
          METADATA_ASSET: ${{ steps.assets.outputs.metadata }}
          PACKAGES_ASSET: ${{ steps.assets.outputs.packages }}
        run: |
          set -euo pipefail
          assets=(
            "${IMAGE_ASSET}"
            "${CHECKSUM_ASSET}"
            "${METADATA_ASSET}"
            "${PACKAGES_ASSET}"
          )
          existing_assets=$(gh release view "${RELEASE_TAG}" \
            --repo "${GITHUB_REPOSITORY}" --json assets --jq '.assets[].name')
          for asset in "${assets[@]}"
          do
            [ -f "${asset}" ] && [ ! -L "${asset}" ] || {
              echo "Release asset is missing or symbolic: ${asset}" >&2
              exit 1
            }
            asset_name=$(basename -- "${asset}")
            if grep -Fx -- "${asset_name}" <<< "${existing_assets}" > /dev/null
            then
              echo "Refusing to replace existing release asset: ${asset_name}" >&2
              exit 1
            fi
          done

          gh release upload "${RELEASE_TAG}" "${assets[@]}" \
            --repo "${GITHUB_REPOSITORY}"

          uploaded_assets=$(gh release view "${RELEASE_TAG}" \
            --repo "${GITHUB_REPOSITORY}" --json assets --jq '.assets[].name')
          for asset in "${assets[@]}"
          do
            grep -Fx -- "$(basename -- "${asset}")" <<< "${uploaded_assets}" > /dev/null || {
              echo "Uploaded asset is not visible on the release: ${asset}" >&2
              exit 1
            }
          done

      - name: Publish verified VERSION-push release
        if: github.event_name == 'push'
        env:
          CHECKSUM_ASSET: ${{ steps.assets.outputs.checksum }}
          GH_TOKEN: ${{ github.token }}
          IMAGE_ASSET: ${{ steps.assets.outputs.image }}
          METADATA_ASSET: ${{ steps.assets.outputs.metadata }}
          PACKAGES_ASSET: ${{ steps.assets.outputs.packages }}
          RELEASE_NOTES_PATH: ${{ steps.release.outputs.release_notes_path }}
          SOURCE_COMMIT: ${{ steps.release.outputs.source_commit }}
          VERSION: ${{ steps.release.outputs.version }}
        run: |
          set -euo pipefail

          resolve_tag_commit() {
            local object_json="$1"
            local object_sha
            local object_type
            local depth=0

            object_type=$(jq -er '.object.type' <<< "${object_json}")
            object_sha=$(jq -er '.object.sha' <<< "${object_json}")
            while [ "${object_type}" = tag ]
            do
              depth=$((depth + 1))
              [ "${depth}" -le 8 ] || return 1
              object_json=$(gh api \
                "repos/${GITHUB_REPOSITORY}/git/tags/${object_sha}")
              object_type=$(jq -er '.object.type' <<< "${object_json}")
              object_sha=$(jq -er '.object.sha' <<< "${object_json}")
            done
            [ "${object_type}" = commit ] || return 1
            printf '%s\n' "${object_sha}"
          }

          tag_response=$(gh api \
            "repos/${GITHUB_REPOSITORY}/git/ref/tags/${RELEASE_TAG}")
          [ "$(resolve_tag_commit "${tag_response}")" = "${SOURCE_COMMIT}" ] || {
            echo "Release tag changed during the image build" >&2
            exit 1
          }

          release_response=$(gh api \
            "repos/${GITHUB_REPOSITORY}/releases/tags/${RELEASE_TAG}")
          prerelease=false
          make_latest=true
          if [[ "${VERSION}" == *-rc.* ]]
          then
            prerelease=true
            make_latest=false
          fi
          expected_title="TeslaUSB Enhanced ${RELEASE_TAG}"
          expected_body=$(< "${RELEASE_NOTES_PATH}")
          jq -e \
            --arg tag "${RELEASE_TAG}" \
            --arg title "${expected_title}" \
            --arg source_commit "${SOURCE_COMMIT}" \
            --argjson prerelease "${prerelease}" \
            '.tag_name == $tag and .name == $title and .draft == true and
             .target_commitish == $source_commit and
             .prerelease == $prerelease' <<< "${release_response}" > /dev/null || {
            echo "Release is no longer the expected unpublished draft" >&2
            exit 1
          }
          [ "$(jq -r '.body // ""' <<< "${release_response}")" = "${expected_body}" ] || {
            echo "Draft release notes changed during the image build" >&2
            exit 1
          }

          assets=(
            "${IMAGE_ASSET}"
            "${CHECKSUM_ASSET}"
            "${METADATA_ASSET}"
            "${PACKAGES_ASSET}"
          )
          for asset in "${assets[@]}"
          do
            asset_name=$(basename -- "${asset}")
            remote_digest=$(jq -er --arg name "${asset_name}" '
              [.assets[] | select(.name == $name)] |
              if length == 1 then .[0].digest else error("asset count mismatch") end
            ' <<< "${release_response}")
            local_digest=$(sha256sum -- "${asset}")
            local_digest="sha256:${local_digest%% *}"
            [ "${remote_digest}" = "${local_digest}" ] || {
              echo "Remote release digest does not match verified asset: ${asset_name}" >&2
              exit 1
            }
          done

          release_id=$(jq -er '.id' <<< "${release_response}")
          publish_payload=$(jq -n \
            --argjson prerelease "${prerelease}" \
            --arg make_latest "${make_latest}" \
            '{draft: false, prerelease: $prerelease, make_latest: $make_latest}')
          published_release=$(gh api --method PATCH \
            "repos/${GITHUB_REPOSITORY}/rele