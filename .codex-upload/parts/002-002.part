ANCH" == /* || "$BRANCH" == */ || "$BRANCH" == *..* ||
        "$BRANCH" == *//* || "$BRANCH" == *'@{'* || "$BRANCH" == @ ]]
  then
    setup_config_message "STOP: BRANCH is not a safe Git reference."
    return 1
  fi
  IFS=/ read -r -a ref_components <<< "$BRANCH"
  for ref_component in "${ref_components[@]}"
  do
    case "$ref_component" in
      ''|.*|*.|*.lock)
        setup_config_message "STOP: BRANCH is not a safe Git reference."
        return 1
        ;;
    esac
  done
}

THISDIR=$(dirname "$(readlink -f "$0")")
if [ ! -e "$THISDIR/envsetup.sh" ]
then
  # Load only enough setup data to locate the requested repository/branch.
  if [ "$TESLAUSB_CONFIG_LOADER_LOADED" = true ]
  then
    teslausb_load_config
  elif [ -e /root/teslausb_setup_variables.conf ]
  then
    setup_config_message "WARNING: using deprecated legacy shell configuration to bootstrap the loader."
    safesource /root/teslausb_setup_variables.conf
  else
    setup_config_message "STOP: a JSON config requires the declarative config loader supplied by the enhanced image."
    exit 1
  fi
  for setup_secret_name in WEB_PASSWORD SAMBA_PASSWORD SSH_USER_PASSWORD \
    SSH_ROOT_PUBLIC_KEY WIFIPASS
  do
    if [[ -v $setup_secret_name ]]
    then
      # shellcheck disable=SC2163 # The variable name is intentionally indirect.
      export -n "$setup_secret_name"
    fi
  done
  unset setup_secret_name
  REPO=${REPO:-marcone}
  BRANCH=${BRANCH:-main-dev}
  validate_source_coordinates || exit 1
  copy_script pi-gen-sources/00-teslausb-tweaks/files/teslausb-config-loader.sh "$THISDIR"
  copy_script pi-gen-sources/00-teslausb-tweaks/files/teslausb_config.py "$THISDIR"
  copy_script setup/pi/envsetup.sh "$THISDIR"
fi
# SC can't follow non-constant source
# shellcheck disable=SC1090
source "$THISDIR/envsetup.sh"

function dehumanize () {
  echo $(($(echo "$1" | sed 's/GB/G/;s/MB/M/;s/KB/K/;s/G/*1024M/;s/M/*1024K/;s/K/*1024/')))
}

REBOOT=false

# wpa_supplicant should have an explicit regulatory country. Never guess one:
# the wrong value can enable channels that are illegal at the device location.
WPA=/etc/wpa_supplicant/wpa_supplicant.conf
if [ -e "$WPA" ] && ! grep -q "country=" $WPA && grep -q "network=" $WPA
then
  if [[ "${WIFI_COUNTRY:-}" =~ ^[A-Z]{2}$ ]]
  then
    setup_progress "adding configured country code to wpa_supplicant.conf"
    printf 'country=%s\n' "$WIFI_COUNTRY" >> "$WPA"
    REBOOT=true
  else
    setup_progress "WARNING: wpa_supplicant.conf has no country code; set WIFI_COUNTRY to an uppercase two-letter regulatory country code."
  fi
fi

BOOT_DISK=$(lsblk -dpno pkname "$(findmnt -D -no SOURCE --target /teslausb)")
declare -rx BOOT_DISK
BOOT_PARTITION_DEVICE=$(lsblk -dpno name "$(findmnt -D -no SOURCE --target /teslausb)")
readonly BOOT_PARTITION_DEVICE
readonly BOOT_DEVICE_PARTITION_PREFIX=${BOOT_PARTITION_DEVICE%?}
export BOOT_DEVICE_PARTITION_PREFIX
ROOT_PARTITION_DEVICE=$(lsblk -dpno name "$(findmnt -D -no SOURCE --target /)")
declare -rx ROOT_PARTITION_DEVICE
readonly ROOT_PART_NUM=${ROOT_PARTITION_DEVICE:0-1}
INCREASE_ROOT_SIZE=$(($(dehumanize "$INCREASE_ROOT_SIZE") / 512))

if [ "$INCREASE_ROOT_SIZE" != "0" ] && [ ! -e "${BOOT_DEVICE_PARTITION_PREFIX}$((ROOT_PART_NUM+1))" ]
then
  if [ ! -e /root/TESLAUSB_ROOT_PARTITION_INCREASED ]
  then
    touch /root/TESLAUSB_ROOT_PARTITION_INCREASED
    ROOTSTART=$(partx --show -g -o START "${ROOT_PARTITION_DEVICE}")
    ROOTSIZE=$(partx --show -g -o SECTORS "${ROOT_PARTITION_DEVICE}")
    ROOTSIZE=$((ROOTSIZE + INCREASE_ROOT_SIZE))
    echo "$ROOTSTART,$ROOTSIZE" | sfdisk --force "${BOOT_DISK}" -N "${ROOT_PART_NUM}"
    setup_progress "increased root partition size"
    REBOOT=true
  else
    setup_progress "increasing root filesystem size to match partition size"
    resize2fs "${ROOT_PARTITION_DEVICE}"
  fi
fi

if [ "$REBOOT" = "true" ]
then
  if stop_if_transaction_requires_reboot 'an early setup change'
  then
    exit 75
  fi
  if [ -t 0 ] && [ "${NO_REBOOT_PROMPT:-}" != "1" ]
  then
    setup_progress "please reboot for changes to take effect"
    exit
  else
    setup_progress "rebooting for changes to take effect"
    reboot
    exit
  fi
fi

function headless_setup_mark_setup_success () {
  rm -f /teslausb/TESLAUSB_SETUP_FAILED
  rm -f /teslausb/TESLAUSB_SETUP_STARTED
  touch /teslausb/TESLAUSB_SETUP_FINISHED
}

function flash () {
  local ON=0
  local OFF=1
  if isPi4 || isPi5
  then
    ON=1
    OFF=0
  fi
  echo none > "$STATUSLED/trigger"
  echo $OFF > "$STATUSLED/brightness"
  sleep 1
  for ((i=1; i<=$1; i++))
  do
    echo $ON > "$STATUSLED/brightness"
    sleep .2
    echo $OFF > "$STATUSLED/brightness"
    sleep .8
  done
}

function headless_setup_progress_flash () {
  if [ ! -t 0 ]
  then
    flash "$1"
  fi
}

function verify_configuration () {
  copy_script setup/pi/verify-configuration.sh "$TESLAUSB_SCRIPT_TMPDIR"

  "$TESLAUSB_SCRIPT_TMPDIR/verify-configuration.sh"
}

function get_common_scripts () {
  setup_progress "Downloading common runtime scripts."
  copy_script setup/pi/transactional-upgrade.sh /root/bin teslausb-upgrade
  copy_script pi-gen-sources/00-teslausb-tweaks/files/teslausb-config-loader.sh /root/bin
  copy_script pi-gen-sources/00-teslausb-tweaks/files/teslausb_config.py /root/bin
  copy_script run/remountfs_rw /root/bin
  copy_script run/make_snapshot.sh /root/bin
  copy_script run/guarded_snapshot.sh /root/bin
  copy_script run/snapshot_contains_encrypted_clips.sh /root/bin
  copy_script run/release_snapshot.sh /root/bin
  copy_script run/manage_free_space.sh /root/bin
  copy_script run/force_sync.sh /root/bin
  copy_script run/detect_encrypted_clips.sh /root/bin
  copy_script run/mountoptsforimage /root/bin
  copy_script run/mountimage /root/bin
  copy_script run/enable_gadget.sh /root/bin
  copy_script run/disable_gadget.sh /root/bin
  copy_script run/repair_gadget.sh /root/bin
  ln -sf /root/bin/mountimage /sbin/mount.teslausb
}

function install_transaction_recovery_service () {
  local recovery_helper=/usr/local/libexec/teslausb-upgrade-recovery
  local source_helper="$TESLAUSB_SCRIPT_TMPDIR/teslausb-upgrade-recovery.new"
  local source_sum
  local installed_sum
  local temporary_helper

  # The boot guard intentionally lives outside the release pointer. If power
  # fails while /root/bin/current is changing, systemd still has a fixed,
  # verified manager with which to restore the journaled known-good release.
  install -d -m 0755 /usr/local/libexec
  copy_script setup/pi/transactional-upgrade.sh "$TESLAUSB_SCRIPT_TMPDIR" \
    teslausb-upgrade-recovery.new
  bash -n "$source_helper"
  source_sum=$(sha256sum "$source_helper" | awk '{print $1}')
  temporary_helper=$(mktemp /usr/local/libexec/.teslausb-upgrade-recovery.XXXXXXXX)
  install -m 0755 -- "$source_helper" "$temporary_helper"
  installed_sum=$(sha256sum "$temporary_helper" | awk '{print $1}')
  if [ "$source_sum" != "$installed_sum" ]
  then
    unlink -- "$temporary_helper"
    setup_progress 'STOP: recovery helper checksum verification failed'
    return 1
  fi
  if ! sync -f -- "$temporary_helper" 2> /dev/null
  then
    sync
  fi
  mv -Tf -- "$temporary_helper" "$recovery_helper"
  if ! sync -f -- /usr/local/libexec 2> /dev/null
  then
    sync
  fi

  install -d -m 0755 /etc/systemd/system/teslausb.service.d
  cat > /etc/systemd/system/teslausb-upgrade-recovery.service <<'EOF'
[Unit]
Description=Recover an interrupted TeslaUSB application activation
DefaultDependencies=no
Requires=mutable.mount
After=mutable.mount
Before=teslausb.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/teslausb-upgrade-recovery recover
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
  chmod 0644 /etc/systemd/system/teslausb-upgrade-recovery.service

  cat > /etc/systemd/system/teslausb.service.d/transaction-recovery.conf <<'EOF'
[Unit]
Requires=teslausb-upgrade-recovery.service
After=teslausb-upgrade-recovery.service
EOF
  chmod 0644 /etc/systemd/system/teslausb.service.d/transaction-recovery.conf

  s