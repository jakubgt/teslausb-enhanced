#!/bin/bash -eu

if [[ $EUID -ne 0 ]]
then
  echo "STOP: Run sudo -i."
  exit 1
fi

if [ "$(. /etc/os-release && echo "${VERSION_ID:-}")" = "9" ]
then
  echo "STOP: Stretch-based install is no longer supported. Please flash the latest prebuilt."
  exit 1
fi

if [ "${FLOCKED:-}" != "$0" ]
then
  if FLOCKED="$0" flock -en -E 99 "$0" "$0" "$@" || case "$?" in
  99) echo already running
      exit 99
      ;;
  *)  exit $?
      ;;
  esac
  then
    # success
    exit 0
  fi
fi

TESLAUSB_SETUP_TMPDIR="$(mktemp -d /tmp/teslausb-setup.XXXXXX)"
readonly TESLAUSB_SETUP_TMPDIR
export TESLAUSB_SETUP_TMPDIR
chmod 0700 "$TESLAUSB_SETUP_TMPDIR"
TESLAUSB_SCRIPT_TMPDIR="$TESLAUSB_SETUP_TMPDIR/scripts"
readonly TESLAUSB_SCRIPT_TMPDIR
mkdir -m 0700 "$TESLAUSB_SCRIPT_TMPDIR"

# Keep automatic timezone discovery reproducible. This is the current head of
# marcone/tzupdate's Python implementation as of 2026-08-02.
readonly TZUPDATE_REVISION=2d41763825fcfae3f2266bf1628ce245ab285f5a
readonly TZUPDATE_SHA256=7e6769fcf6c2a19a3492a9d62bd529714081132b12244796a4800269804857cb
readonly TZUPDATE_MAX_BYTES=131072
readonly TZUPDATE_URL="https://raw.githubusercontent.com/marcone/tzupdate/${TZUPDATE_REVISION}/tzupdate.py"

function cleanup_setup_tmpdir () {
  local status=$?
  local cleanup_safe=true
  trap - EXIT
  if mountpoint -q -- "$TESLAUSB_SETUP_TMPDIR/diagnostic-root" 2> /dev/null
  then
    if ! umount "$TESLAUSB_SETUP_TMPDIR/diagnostic-root"
    then
      cleanup_safe=false
      printf '%s\n' "WARNING: could not unmount the private diagnostics staging directory" >&2
    fi
  fi
  if mountpoint -q -- "$TESLAUSB_SETUP_TMPDIR/sourcedir" 2> /dev/null
  then
    if ! umount "$TESLAUSB_SETUP_TMPDIR/sourcedir"
    then
      cleanup_safe=false
      printf '%s\n' "WARNING: could not unmount the private source staging directory" >&2
    fi
  fi
  if [ "$cleanup_safe" = "true" ]
  then
    rm -rf -- "$TESLAUSB_SETUP_TMPDIR"
  fi
  exit "$status"
}
trap cleanup_setup_tmpdir EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

function setup_progress () {
  local setup_logfile=/teslausb/teslausb-headless-setup.log
  if [ -w $setup_logfile ]
  then
    echo "$( date ) : $*" >> "$setup_logfile"
  fi
  echo "$@"
}

function stop_if_transaction_requires_reboot () {
  local reason="$1"
  if [ "${TESLAUSB_TRANSACTIONAL_UPGRADE:-0}" = 1 ]
  then
    setup_progress "STOP: $reason requires a reboot before transactional activation. The candidate will be discarded; reboot the Pi and run the upgrade again."
    return 0
  fi
  return 1
}

function curlwrapper () {
  setup_progress "curl $*" > /dev/null
  local attempts=0
  local curl_error="$TESLAUSB_SETUP_TMPDIR/curl.err"
  while ! curl -s -S --stderr "$curl_error" --fail \
    --connect-timeout 15 --max-time 300 "$@"
  do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 20 ]
    then
      setup_progress "giving up after 20 tries"
      if [ -e "$curl_error" ]
      then
        setup_progress "$(cat "$curl_error")"
      else
        setup_progress '(no reason given)'
      fi
      exit 1
    fi
    setup_progress "'curl $*' failed, retrying" > /dev/null
    sntp -S time.google.com || ntpdig -S time.google.com || true
    sleep 3
  done
}

function verify_tzupdate_checksum () {
  local candidate="$1"
  local expected_sha256="$2"
  local actual_sha256

  if [ ! -f "$candidate" ] || [ -L "$candidate" ] ||
     ! [[ "$expected_sha256" =~ ^[[:xdigit:]]{64}$ ]]
  then
    return 1
  fi

  actual_sha256="$(sha256sum -- "$candidate")" || return 1
  actual_sha256="${actual_sha256%% *}"
  [ "$actual_sha256" = "$expected_sha256" ]
}

function copy_script () {
  local remote_path="$1"
  local name="${3:-${1/*\/}}"
  local local_path="$2"
  local managed_target

  if ! [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$ ]]
  then
    setup_progress "STOP: unsafe script install name: $name"
    return 1
  fi

  if [ -z ${SOURCE_DIR:+x} ]
  then
    if declare -F download_sources &> /dev/null
    then
      download_sources
    else
      export SOURCE_DIR="$TESLAUSB_SETUP_TMPDIR/sourcedir"
      mkdir -m 0700 "$SOURCE_DIR"
      mount -t tmpfs -o nodev,nosuid,mode=0700 none "$SOURCE_DIR"
      (
        cd "$SOURCE_DIR"
        curlwrapper -L "https://github.com/${REPO}/teslausb/archive/${BRANCH}.tar.gz" | tar zxf - --strip-components=1
      )
    fi
  fi

  # A transactional upgrade builds the complete /root/bin candidate without
  # touching the currently active scripts. The release manager performs both
  # the copy and an immediate source/destination checksum comparison.
  if [ -n "${TESLAUSB_UPGRADE_STAGING_DIR:-}" ] && \
     [ "${local_path%/}" = /root/bin ]
  then
    if [ -z "${TESLAUSB_TRANSACTION_MANAGER:-}" ] || \
       [ ! -x "$TESLAUSB_TRANSACTION_MANAGER" ]
    then
      setup_progress 'STOP: transactional upgrade manager is unavailable'
      return 1
    fi
    "$TESLAUSB_TRANSACTION_MANAGER" stage-file \
      "$TESLAUSB_UPGRADE_STAGING_DIR" "${SOURCE_DIR}/$remote_path" "$name"
    setup_progress "Staged $name for transactional activation ..."
    return
  fi

  managed_target="$local_path/$name"
  if [ -L "$managed_target" ] && \
     [[ "$(readlink -- "$managed_target")" == \
        */application-releases/current/root-bin/* ]]
  then
    setup_progress "STOP: $managed_target belongs to an immutable release. Run '$0 upgrade' instead of overwriting it."
    return 1
  fi

  cp "${SOURCE_DIR}/$remote_path" "$local_path/$name"
  chmod +x "$local_path/$name"
  setup_progress "Downloaded $local_path/$name ..."
}

function setup_config_message {
  setup_progress "$*"
}

function secure_setup_config_file {
  local setup_config="$1"
  local metadata
  local owner_id
  local group_id
  local mode

  if [ -L "$setup_config" ] || [ ! -f "$setup_config" ]
  then
    setup_config_message "STOP: $setup_config must be a regular file, not a symbolic link."
    return 1
  fi
  metadata="$(stat -c '%u:%g:%a' -- "$setup_config")" || {
    setup_config_message "STOP: unable to inspect $setup_config."
    return 1
  }
  IFS=: read -r owner_id group_id mode <<< "$metadata"
  if [ "$owner_id" != "0" ] || [ "$group_id" != "0" ]
  then
    setup_config_message "STOP: $setup_config must be owned by root:root."
    return 1
  fi
  if [ "$mode" != "600" ] && ! chmod 0600 -- "$setup_config"
  then
    setup_config_message "STOP: unable to set root-only (0600) permissions on $setup_config. Remount the root filesystem writable and retry."
    return 1
  fi
  mode="$(stat -c '%a' -- "$setup_config")" || return 1
  if [ "$mode" != "600" ]
  then
    setup_config_message "STOP: $setup_config must have mode 0600."
    return 1
  fi
}

function safesource {
  local setup_config="$1"
  local failure_output

  secure_setup_config_file "$setup_config" || exit 1
  if failure_output="$(
    (
      set -eu
      # shellcheck disable=SC1090 # Path is validated and root-owned above.
      source "$setup_config"
    ) 2>&1
  )"
  then
    :
  else
    setup_config_message "Error in $setup_config:"
    setup_config_message "$failure_output"
    exit 1
  fi
  # shellcheck disable=SC1090
  source "$setup_config"
}

TESLAUSB_CONFIG_LOADER_LOADED=false
for teslausb_loader_candidate in \
  "$(dirname "$(readlink -f "$0")")/teslausb-config-loader.sh" \
  /root/bin/teslausb-config-loader.sh \
  /usr/local/lib/teslausb/teslausb-config-loader.sh
do
  if [ -r "$teslausb_loader_candidate" ]
  then
    # shellcheck source=/dev/null
    source "$teslausb_loader_candidate"
    TESLAUSB_CONFIG_LOADER_LOADED=true
    break
  fi
done
unset teslausb_loader_candidate

function validate_source_coordinates {
  local ref_component
  local -a ref_components=()

  if ! [[ "$REPO" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$ ]]
  then
    setup_config_message "STOP: REPO must be a GitHub owner name (letters, numbers, and non-edge dashes only)."
    return 1
  fi
  if [ -z "$BRANCH" ] || [ "${#BRANCH}" -gt 255 ] ||
     ! [[ "$BRANCH" =~ ^[A-Za-z0-9._/-]+$ ]] ||
     [[ "$BR