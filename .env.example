# Local cloud viewer web port
CLOUD_VIEWER_PORT=18080

# Local folder containing TeslaCam tree (RecentClips/SavedClips/SentryClips)
LOCAL_TESLACAM_PATH=./local-TeslaCam

# Cloud mode default provider for legacy/no-provider API requests
CLOUD_PROVIDER=gcs

# Set one or both provider buckets below. Leave both empty to disable Cloud source.

# GCS
GCS_BUCKET=
GCS_PREFIX=TeslaCam
GCS_SIGN_TTL_SECONDS=900

# Directory that contains gcs-service-account.json
GCS_CREDENTIALS_DIR=.

# S3
S3_BUCKET=
S3_PREFIX=TeslaCam
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_SIGN_TTL_SECONDS=900

# AWS credentials (optional if using instance profile/SSO/other default chain)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
