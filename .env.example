# Local cloud viewer web port
CLOUD_VIEWER_PORT=18080

# Local folder containing TeslaCam tree (RecentClips/SavedClips/SentryClips)
LOCAL_TESLACAM_PATH=./local-TeslaCam

# Cloud mode (optional). Leave GCS_BUCKET empty to disable Cloud source.
GCS_BUCKET=
GCS_PREFIX=TeslaCam
GCS_SIGN_TTL_SECONDS=900

# Directory that contains gcs-service-account.json
GCS_CREDENTIALS_DIR=.
