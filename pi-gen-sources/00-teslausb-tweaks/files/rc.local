#!/bin/bash -e
#
# rc.local
#
# This script is executed at the end of each multiuser runlevel.
# Make sure that the script will "exit 0" on success or any other
# value on error.
#
# In order to enable or disable this script just change the execution
# bits.
#
# By default this script does nothing.

# Print the IP address
_IP=$(hostname -I) || true
if [ "$_IP" ]
then
  printf "My IP address is %s\n" "$_IP"
fi

if [ ! -L /teslausb ]
then
  if [ -e /teslausb ] && ! rmdir /teslausb
  then
    echo "STOP: /teslausb exists and is not an empty directory or symbolic link" >&2
    exit 1
  fi
  if [ -d /boot/firmware ] && findmnt --fstab /boot/firmware &> /dev/null
  then
    ln -s /boot/firmware /teslausb
  else
    ln -s /boot /teslausb
  fi
fi

RC_LOCAL_TMPDIR="$(mktemp -d /tmp/teslausb-rc-local.XXXXXX)"
readonly RC_LOCAL_TMPDIR
chmod 0700 "$RC_LOCAL_TMPDIR"
function cleanup_rc_local_tmpdir {
  # shellcheck disable=SC2317 # Invoked by the EXIT trap.
  rm -rf -- "$RC_LOCAL_TMPDIR"
}
trap cleanup_rc_local_tmpdir EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

SETUP_LOGFILE=/teslausb/teslausb-headless-setup.log

function setup_progress () {
  # The root and boot filesystems can intentionally be read-only at this
  # point. Redirect stderr before opening the log so a failed append remains
  # non-fatal and the message is still available in the boot journal.
  printf '%s : %s\n' "$(date)" "$*" 2> /dev/null >> "$SETUP_LOGFILE" || true
  printf '%s\n' "$*"
}

if [ -f /teslausb/run_once ]
then
  install -o root -g root -m 0700 -- /teslausb/run_once "$RC_LOCAL_TMPDIR/run_once"
  if "$RC_LOCAL_TMPDIR/run_once"
  then
    if [ ! -e /teslausb/run_once ] && [ ! -L /teslausb/run_once ]
    then
      setup_progress "run_once succeeded and consumed its own trigger"
    elif ! mv /teslausb/run_once /teslausb/ran_once
    then
      setup_progress "WARNING: run_once succeeded but could not be renamed; it will be retried"
      exit 1
    fi
  else
    setup_progress "run_once failed; leaving it in place for retry"
    exit 1
  fi
fi

function write_all_leds {
  for led in /sys/class/leds/*
  do
    echo "$1" > "$led/$2" || true
  done &> /dev/null
}

function error_strobe() {
  modprobe ledtrig_timer || true
  write_all_leds timer trigger
  while true
  do
    write_all_leds 1 delay_on
    write_all_leds 100 delay_off
    sleep 1
    write_all_leds 0 delay_on
    sleep 1
  done
}

function get_script () {
  local local_path="$1"
  local name="$2"
  local remote_path="${3:-}"

  IFS=". " read -r start_time _ < /proc/uptime

  while ! curl --fail --silent --show-error --connect-timeout 15 --max-time 120 \
    -o "$local_path/$name" https://raw.githubusercontent.com/"$REPO"/teslausb/"$BRANCH"/"$remote_path"/"$name"
  do
    setup_progress "get_script failed, retrying"
    sntp -S time.google.com || ntpdig -S time.google.com || true
    sleep 3
    IFS=". " read -r now _ < /proc/uptime
    if [ $((now - start_time)) -gt 60 ]
    then
      setup_progress "failed to get script after 60 seconds, exiting"
      return 1
    fi
  done
  chmod +x "$local_path/$name"
}

function nm_connect_wifi () {
  IFS=". " read -r start_time _ < /proc/uptime

  while ! nmcli device wifi connect "$SSID" password "$WIFIPASS" hidden yes
  do
    IFS=". " read -r now _ < /proc/uptime
    if [ $((now - start_time)) -gt 60 ]
    then
      setup_progress "failed to connect to wifi after 60 seconds, exiting"
      return 1
    fi
    setup_progress "failed to connect to wifi, retrying"
    sleep 5
  done
}

function configure_wifi_country () {
  if ! [[ "${WIFI_COUNTRY:-}" =~ ^[A-Z]{2}$ ]]
  then
    setup_progress "STOP: WIFI_COUNTRY must be an uppercase two-letter regulatory country code before Wi-Fi can be enabled."
    return 1
  fi
  if ! command -v raspi-config > /dev/null ||
     ! raspi-config nonint do_wifi_country "$WIFI_COUNTRY"
  then
    setup_progress "STOP: failed to configure the Wi-Fi regulatory country '$WIFI_COUNTRY'."
    return 1
  fi
  rfkill unblock wifi &> /dev/null || true
}

function validate_teslausb_hostname () {
  [ -n "$TESLAUSB_HOSTNAME" ] && [ "${#TESLAUSB_HOSTNAME}" -le 63 ] &&
    [[ "$TESLAUSB_HOSTNAME" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]]
}

function write_hostname_files () {
  local old_host_name="$1"
  local new_host_name="$2"
  local hosts_tmp
  local hostname_tmp

  hosts_tmp="$(mktemp /etc/.hosts.XXXXXX)"
  hostname_tmp="$(mktemp /etc/.hostname.XXXXXX)"
  if ! awk -v old="$old_host_name" -v new="$new_host_name" '
    BEGIN { OFS="\t" }
    {
      for (i = 2; i <= NF; i++) {
        if (substr($i, 1, 1) == "#") break
        if ($i == old) $i = new
      }
      print
    }
  ' /etc/hosts > "$hosts_tmp" ||
     ! printf '%s\n' "$new_host_name" > "$hostname_tmp"
  then
    rm -f -- "$hosts_tmp" "$hostname_tmp"
    return 1
  fi
  chown root:root "$hosts_tmp" "$hostname_tmp"
  chmod 0644 "$hosts_tmp" "$hostname_tmp"
  mv -fT -- "$hosts_tmp" /etc/hosts
  mv -fT -- "$hostname_tmp" /etc/hostname
}

function enable_wifi () {
  setup_progress "Detecting whether to configure wifi"
  if [[ -n "$SSID" ]] && [[ -n "$WIFIPASS" ]]
  then
    if [ ! -e /teslausb/WIFI_ENABLED ]
    then
      if [ -x /root/bin/remountfs_rw ]
      then
        /root/bin/remountfs_rw
      fi
      if ! configure_wifi_country
      then
        error_strobe &
        exit 1
      fi
      if systemctl -q is-enabled NetworkManager.service
      then
        setup_progress "Connecting to wifi using Network Manager"
        if ! nm_connect_wifi
        then
          setup_progress "Failed to connect to wifi"
          error_strobe &
          exit 0
        fi
      else
        setup_progress "Configuring wpa_supplicant"
        wpa_raw="$RC_LOCAL_TMPDIR/wpa_supplicant.raw"
        wpa_config="$RC_LOCAL_TMPDIR/wpa_supplicant.conf"
        if ! printf '%s\n' "$WIFIPASS" | wpa_passphrase "$SSID" > "$wpa_raw"
        then
          setup_progress "Failed to encode the Wi-Fi credentials"
          error_strobe &
          exit 1
        fi
        {
          printf 'country=%s\n' "$WIFI_COUNTRY"
          sed '/^network={[[:space:]]*$/,$d' /teslausb/wpa_supplicant.conf.sample
          # wpa_passphrase emits a plaintext passphrase comment; never persist it.
          sed '/^[[:space:]]*#psk=/d' "$wpa_raw"
        } > "$wpa_config"
        install -o root -g root -m 0600 -- "$wpa_config" /etc/wpa_supplicant/wpa_supplicant.conf
      fi

      # set the host name now if possible, so it's effective immediately after the reboot
      local old_host_name
      old_host_name=$(cat /etc/hostname)
      if [[ -n "$TESLAUSB_HOSTNAME" ]] && [[ "$TESLAUSB_HOSTNAME" != "$old_host_name" ]]
      then
        local new_host_name="$TESLAUSB_HOSTNAME"
        write_hostname_files "$old_host_name" "$new_host_name"
      fi

      dpkg-reconfigure -f noninteractive openssh-server
      rfkill unblock wifi &> /dev/null || true
      for i in /var/lib/systemd/rfkill/*:wlan ; do
        echo 0 > "$i"
      done
      systemctl enable ssh

      touch /teslausb/WIFI_ENABLED
      setup_progress "Rebooting..."
      exec reboot
    fi
  else
    setup_progress "skipping wifi setup because variables not specified"
  fi
}

readonly TESLAUSB_CONFIG_LOADER=/usr/local/lib/teslausb/teslausb-config-loader.sh
if [ ! -r "$TESLAUSB_CONFIG_LOADER" ]
then
  setup_progress "STOP: declarative configuration loader is missing."
  error_strobe &
  exit 1
fi
# shellcheck source=/dev/null
source "$TESLAUSB_CONFIG_LOADER"

function validate_source_coordinates {
  local ref_component
  local -a ref_components=()

  if ! [[ "$REPO" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$ ]]
  then
    setup_progress "STOP: REPO must be a GitHub owner name (letters, numbers, and non-edge dashes only)."
    return 1
  fi
  if [ -z "$BRANCH" ] || [ "${#BRANCH}" -gt 255 ] ||
     ! [[ "$BRANCH" =~ ^[A-Za-z0-9._/-]+$ ]] ||
     [[ "$BRANCH" == /* || "$BRANCH" == */ || "$BRANCH" == *..* ||
        "$BRANCH" == *//* || "$BRANCH" == *'@{'* || "$BRANCH" == @ ]]
  then
    setup_progress "STOP: BRANCH is not a safe Git reference."
    return 1
  fi
  IFS=/ read -r -a ref_components <<< "$BRANCH"
  for ref_component in "${ref_components[@]}"
  do
    case "$ref_component" in
      ''|.*|*.|*.lock)
        setup_progress "STOP: BRANCH is not a safe Git reference."
        return 1
        ;;
    esac
  done
}

function install_setup_config {
  local source_config="$1"
  local destination_config="$2"
  local config_tmp

  if [ -L "$source_config" ] || [ ! -f "$source_config" ]
  then
    setup_progress "STOP: $source_config must be a regular file, not a symbolic link."
    return 1
  fi
  if [ -L "$destination_config" ]
  then
    setup_progress "STOP: refusing to replace symbolic-link config $destination_config."
    return 1
  fi

  config_tmp="$(mktemp /root/.teslausb-setup-config.XXXXXX)"
  if ! install -o root -g root -m 0600 -- "$source_config" "$config_tmp" ||
     ! dos2unix "$config_tmp" ||
     ! mv -fT -- "$config_tmp" "$destination_config"
  then
    rm -f -- "$config_tmp"
    return 1
  fi
  rm -f -- "$source_config"
  teslausb_secure_config "$destination_config"
}

function default_login_user {
  awk -F: '$3 == 1000 { print $1; exit }' /etc/passwd
}

function provision_fresh_image_ssh_access {
  local login_user
  local ssh_dir
  local authorized_keys_tmp

  if [ -e /teslausb/TESLAUSB_SETUP_FINISHED ]
  then
    return
  fi
  login_user="$(default_login_user)"
  if [ -n "${SSH_USER_PASSWORD:-}" ]
  then
    if [ -z "$login_user" ]
    then
      setup_progress "STOP: SSH_USER_PASSWORD was set, but no UID 1000 login user exists."
      exit 1
    fi
    case "$SSH_USER_PASSWORD" in
      *$'\r'*|*$'\n'*)
        setup_progress "STOP: SSH_USER_PASSWORD must not contain a newline."
        exit 1
        ;;
    esac
    if [ "$(LC_ALL=C; printf %s "$SSH_USER_PASSWORD" | wc -c)" -lt 12 ] ||
       [ "${SSH_USER_PASSWORD,,}" = raspberry ] ||
       [ "${SSH_USER_PASSWORD,,}" = password ]
    then
      setup_progress "STOP: SSH_USER_PASSWORD must be a non-default password of at least 12 bytes."
      exit 1
    fi
    printf '%s:%s\n' "$login_user" "$SSH_USER_PASSWORD" | chpasswd
  elif [ "${SSH_ALLOW_DEFAULT_PASSWORD:-false}" = "true" ] && [ -n "$login_user" ]
  then
    setup_progress "WARNING: explicitly retaining the image's default SSH password."
    passwd --unlock "$login_user" > /dev/null
  fi

  if [ -n "${SSH_ROOT_PUBLIC_KEY:-}" ]
  then
    case "$SSH_ROOT_PUBLIC_KEY" in
      *$'\r'*|*$'\n'*)
        setup_progress "STOP: SSH_ROOT_PUBLIC_KEY must contain exactly one public-key line."
        exit 1
        ;;
    esac
    ssh_dir=/root/.ssh
    install -d -o root -g root -m 0700 "$ssh_dir"
    authorized_keys_tmp="$(mktemp "$ssh_dir/.authorized_keys.XXXXXX")"
    printf '%s\n' "$SSH_ROOT_PUBLIC_KEY" > "$authorized_keys_tmp"
    if ! ssh-keygen -l -f "$authorized_keys_tmp" > /dev/null
    then
      rm -f -- "$authorized_keys_tmp"
      setup_progress "STOP: SSH_ROOT_PUBLIC_KEY is not a valid OpenSSH public key."
      exit 1
    fi
    chown root:root "$authorized_keys_tmp"
    chmod 0600 "$authorized_keys_tmp"
    mv -fT -- "$authorized_keys_tmp" "$ssh_dir/authorized_keys"
  fi
}

if [ -e "/teslausb/teslausb_setup.json" ]
then
  if [ -e /root/bin/remountfs_rw ]
  then
    /root/bin/remountfs_rw
  fi
  install_setup_config /teslausb/teslausb_setup.json /root/teslausb_setup.json
elif [ -e "/teslausb/teslausb_setup_variables.conf" ]
then
  if [ -e /root/bin/remountfs_rw ]
  then
    /root/bin/remountfs_rw
  fi
  install_setup_config /teslausb/teslausb_setup_variables.conf /root/teslausb_setup_variables.conf
fi
if [ -e "/root/teslausb_setup.json" ] || [ -e "/root/teslausb_setup_variables.conf" ]
then
  teslausb_load_config || {
    error_strobe &
    exit 1
  }
elif [ -e "/teslausb/teslausb_setup.json.sample" ] || \
     [ -e "/teslausb/teslausb_setup_variables.conf.sample" ]
then
  setup_progress "no setup config found, but a sample file is present."
else
  setup_progress "no config file found."
fi

TESLAUSB_HOSTNAME=${TESLAUSB_HOSTNAME:-teslausb}
if ! validate_teslausb_hostname
then
  setup_progress "STOP: TESLAUSB_HOSTNAME must be a single 1-63 character DNS label."
  error_strobe &
  exit 1
fi

for rc_secret_name in WIFIPASS SSH_USER_PASSWORD SSH_ROOT_PUBLIC_KEY
do
  if [[ -v $rc_secret_name ]]
  then
    # shellcheck disable=SC2163 # The variable name is intentionally indirect.
    export -n "$rc_secret_name"
  fi
done
unset rc_secret_name

provision_fresh_image_ssh_access

# check if we previously marked wifi as enabled
enable_wifi
# Good to start setup at this point

# This begins the Headless Setup loop
# If the FINISHED file does not exist then we start setup. Otherwise passes on to normal loop
if [ ! -e "/teslausb/TESLAUSB_SETUP_FINISHED" ]
then
  if [ -e /root/bin/remountfs_rw ]
  then
    /root/bin/remountfs_rw
  fi
  touch "/teslausb/TESLAUSB_SETUP_STARTED"

  if [ -e "/root/teslausb_setup.json" ] || [ -e "/root/teslausb_setup_variables.conf" ]
  then
    teslausb_load_config
  else
    setup_progress "Setup appears incomplete, but no teslausb_setup.json or legacy .conf was provided."
  fi

  # Make the bin dir if needed to grab the setup script into it and persist
  if [ ! -d "/root/bin" ]
  then
    mkdir "/root/bin"
  fi

  # Images built from this source include an exact, read-only setup snapshot.
  # Prefer it over a network download so private forks need no embedded token
  # and first boot cannot drift to a newer upstream commit.
  if [ -f /usr/local/share/teslausb-source/setup/pi/setup-teslausb ]
  then
    export SOURCE_DIR=/usr/local/share/teslausb-source
  fi

  if [ ! -e "/root/bin/setup-teslausb" ]
  then
    REPO=${REPO:-marcone}
    BRANCH=${BRANCH:-main-dev}
    if ! validate_source_coordinates
    then
      error_strobe &
      exit 1
    fi
    if [ -n "${SOURCE_DIR:-}" ]
    then
      setup_progress "Installing the bundled setup file."
      install -o root -g root -m 0755 \
        "$SOURCE_DIR/setup/pi/setup-teslausb" /root/bin/setup-teslausb
    else
      # Script doesn't exist and this is an older unbundled image: download it.
      setup_progress "Grabbing main setup file."
    fi
    if [ ! -e /root/bin/setup-teslausb ] && \
       ! get_script /root/bin setup-teslausb setup/pi
    then
      setup_progress "Failed to retrieve setup script. Check network settings."
      error_strobe &
      exit 0
    fi
  fi

  setup_progress "Starting setup."

  # Start setup. This should take us all the way through to reboot
  if ! /root/bin/setup-teslausb
  then
    error_strobe &
    exit 0
  fi

  # reboot for good measure, also restarts the rc.local script
  exec reboot
fi

# we're done. If setup completed successfully, teslausb will have been
# started as a systemd service at this point

exit 0
