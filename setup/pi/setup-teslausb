function install_transaction_recovery_service () {
  local recovery_helper=/usr/local/libexec/teslausb-upgrade-recovery
  local source_helper="$TESLAUSB_SCRIPT_TMPDIR/teslausb-upgrade-recovery.new"
  local mutable_mount_options
  local source_sum
  local installed_sum
  local temporary_helper

  if ! mutable_mount_options=$(findmnt -rn -o OPTIONS \
       --mountpoint "$MUTABLE_MOUNTPOINT") ||
     [[ ",$mutable_mount_options," != *,rw,* ]]
  then
    setup_progress 'STOP: the mutable filesystem must be mounted read-write before installing transaction recovery'
    return 1
  fi

  # The boot guard intentionally lives outside the release pointer. If power
  # fails while /root/bin/current is changing, systemd still has a fixed,
  # verified manager with which to restore the journaled known-good release.
  install -d -m 0755 /usr/local/libexec
  copy_script setup/pi/transactional-upgrade.sh "$TESLAUSB_SCRIPT_TMPDIR" \
    teslausb-upgrade-recovery.new
  bash -n "$source_helper"
  source_sum=$(sha256sum "$source_helper" | awk '{print $1}')
  temporary_helper=$(mktemp /usr/local/libexec/.teslausb-upgrade-recovery.XXXXXXXX)
  install -m 0755 -- "$source_helper" "$temporary_helper"
  installed_sum=$(sha256sum "$temporary_helper" | awk '{print $1}')
  if [ "$source_sum" != "$installed_sum" ]
  then
    unlink -- "$temporary_helper"
    setup_progress 'STOP: recovery helper checksum verification failed'
    return 1
  fi
  if ! sync -f -- "$temporary_helper" 2> /dev/null
  then
    sync
  fi
  mv -Tf -- "$temporary_helper" "$recovery_helper"
  if ! sync -f -- /usr/local/libexec 2> /dev/null
  then
    sync
  fi

  install -d -m 0755 /etc/systemd/system/teslausb.service.d
  cat > /etc/systemd/system/teslausb-upgrade-recovery.service <<'EOF'
[Unit]
Description=Recover an interrupted TeslaUSB application activation
DefaultDependencies=no
Requires=mutable.mount
After=mutable.mount
Before=teslausb.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/teslausb-upgrade-recovery recover
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
  chmod 0644 /etc/systemd/system/teslausb-upgrade-recovery.service

  cat > /etc/systemd/system/teslausb.service.d/transaction-recovery.conf <<'EOF'
[Unit]
Requires=teslausb-upgrade-recovery.service
After=teslausb-upgrade-recovery.service
EOF
  chmod 0644 /etc/systemd/system/teslausb.service.d/transaction-recovery.conf

  systemctl daemon-reload
  systemctl enable teslausb-upgrade-recovery.service
  # Keep the oneshot active for the remainder of this boot. A later health
  # restart of teslausb.service must not mistake the in-progress journal for a
  # boot-time interruption and roll it back before it can be tested.
  systemctl start teslausb-upgrade-recovery.service
}

# If only the dwc2 module is loaded at boot then the Pi will present
# itself as a non-responsive USB device until a gadget is created.
# When connected to a Windows host, this will show as a device with
# vendor ID 0 (which is invalid), and Windows might pop up an error
# message saying "USB device not recognized", while a connected Linux
# host will log messages like "device descriptor read/64, error -110"
# to the kernel log, and 'lsusb' might hang for over a minute or until
# a gadget is created.
# To work around this, make sure the g_ether module is loaded along
# with dwc2. The archiveloop script will then unload the g_ether
# module (the attached host will see no device at all at this point)
# before creating the mass storage gadget.
function fix_cmdline_txt_modules_load () {
  local cmdline_tmp
  local existing_module
  local module
  local module_list
  local modules_parameter=modules-load=dwc2,g_ether
  local normalized_cmdline
  local original_cmdline
  local token
  local -a cmdline_lines=()
  local -a cmdline_tokens=()
  local -a extra_modules=()
  local -a modules=()
  local -a normalized_tokens=()

  if [ -L "$CMDLINE_PATH" ]
  then
    setup_progress "STOP: cmdline.txt must not be a symbolic link"
    return 1
  fi
  if [ ! -f "$CMDLINE_PATH" ]
  then
    setup_progress "cmdline.txt does not exist, skipping"
    return
  fi
  mapfile -t cmdline_lines < "$CMDLINE_PATH"
  if [ "${#cmdline_lines[@]}" -ne 1 ] ||
     [[ "${cmdline_lines[0]}" == *$'\r'* ]]
  then
    setup_progress "STOP: cmdline.txt must contain exactly one Unix-format line"
    return 1
  fi
  original_cmdline=${cmdline_lines[0]}
  read -r -a cmdline_tokens <<< "$original_cmdline"
  [ "${#cmdline_tokens[@]}" -gt 0 ] || {
    setup_progress "STOP: cmdline.txt is empty"
    return 1
  }

  for token in "${cmdline_tokens[@]}"
  do
    case "$token" in
      modules-load=*|modules.load=*)
        module_list=${token#*=}
        IFS=, read -r -a modules <<< "$module_list"
        for module in "${modules[@]}"
        do
          [ -n "$module" ] || continue
          case "$module" in
            dwc2|g_ether) continue ;;
          esac
          for existing_module in "${extra_modules[@]}"
          do
            [ "$existing_module" != "$module" ] || continue 2
          done
          extra_modules+=("$module")
        done
        ;;
      *) normalized_tokens+=("$token") ;;
    esac
  done
  for module in "${extra_modules[@]}"
  do
    modules_parameter+=",$module"
  done
  normalized_tokens+=("$modules_parameter")
  normalized_cmdline=${normalized_tokens[*]}

  if [ "$original_cmdline" = "$normalized_cmdline" ]
  then
    setup_progress "cmdline.txt is up to date"
    return
  fi

  setup_progress "Updated cmdline.txt from:"
  setup_progress "$original_cmdline"
  cmdline_tmp=$(mktemp "$(dirname -- "$CMDLINE_PATH")/.cmdline.txt.XXXXXXXX")
  if ! printf '%s\n' "$normalized_cmdline" > "$cmdline_tmp" ||
     ! chown --reference="$CMDLINE_PATH" "$cmdline_tmp" ||
     ! chmod --reference="$CMDLINE_PATH" "$cmdline_tmp" ||
     ! mv -fT -- "$cmdline_tmp" "$CMDLINE_PATH"
  then
    rm -f -- "$cmdline_tmp"
    setup_progress "STOP: unable to update cmdline.txt"
    return 1
  fi
  setup_progress "to:"
  setup_progress "$normalized_cmdline"
}

BACKINGFILES_MOUNTPOINT=/backingfiles
MUTABLE_MOUNTPOINT=/mutable

function update_backingfiles_fstab_entry () {
  local filename="$1"
  local mountpoint="$2"
  sed -i "\@^$filename .*@d" /etc/fstab
  if [ -e "$filename" ]
  then
    mkdir -p "$mountpoint"
    echo "$filename $mountpoint teslausb noauto 0 0" >> /etc/fstab
    setup_progress "updated /etc/fstab for $mountpoint"
  fi
}

function mount_with_retry () {
  for i in {1..5}
  do
    if mount "$@"
    then
      return
    fi
    setup_progress "'mount $*' failed, retrying"
    sleep 1
  done
  return 1
}

function create_usb_drive_backing_files () {
  if [ ! -e "$BACKINGFILES_MOUNTPOINT" ]
  then
    mkdir "$BACKINGFILES_MOUNTPOINT"
  fi

  if [ ! -e "$MUTABLE_MOUNTPOINT" ]
  then
    mkdir "$MUTABLE_MOUNTPOINT"
  fi

  copy_script setup/pi/create-backingfiles-partition.sh "$TESLAUSB_SCRIPT_TMPDIR"
  "$TESLAUSB_SCRIPT_TMPDIR/create-backingfiles-partition.sh" "$BACKINGFILES_MOUNTPOINT" "$MUTABLE_MOUNTPOINT"

  if ! findmnt --mountpoint $BACKINGFILES_MOUNTPOINT > /dev/null
  then
    setup_progress "Mounting the partition for the backing files..."
    mount $BACKINGFILES_MOUNTPOINT
    setup_progress "Mounted the partition for the backing files."
  fi

  if ! findmnt --mountpoint $MUTABLE_MOUNTPOINT > /dev/null
  then
    setup_progress "Mounting the mutable partition..."
    mount $MUTABLE_MOUNTPOINT
    setup_progress "Mounted the mutable partition."
  fi

  setup_progress "Creating backing disk files."
  copy_script setup/pi/create-backingfiles.sh "$TESLAUSB_SCRIPT_TMPDIR"
  "$TESLAUSB_SCRIPT_TMPDIR/create-backingfiles.sh" "$CAM_SIZE" "$MUSIC_SIZE" "$LIGHTSHOW_SIZE" "$BOOMBOX_SIZE" "$BACKINGFILES_MOUNTPOINT" "$USE_EXFAT"

  update_backingfiles_fstab_entry $BACKINGFILES_MOUNTPOINT/cam_disk.bin /mnt/cam
  update_backingfiles_fstab_entry $BACKINGFILES_MOUNTPOINT/music_disk.bin /mnt/music
  update_backingfiles_fstab_entry $BACKINGFILES_MOUNTPOINT/lightshow_disk.bin /mnt/lightshow
  update_backingfiles_fstab_entry $BACKINGFILES_MOUNTPOINT/boombox_disk.bin /mnt/boombox

  # mount cam image and make sure the right directories exist
  umount /mnt/cam > /dev/null || true
  local ret=0
  /root/bin/disable_gadget.sh || ret=$?
  if (( (ret == 0) || (ret == 2) ))
  then
    if [ -e /backingfiles/cam_disk.bin ] && mount_with_retry /mnt/cam
    then
      mkdir -p /mnt/cam/TeslaCam
      mkdir -p /mnt/cam/TeslaTrackMode
      touch /mnt/cam/.metadata_never_index

      local -r sentrylist_previously_archived=/mutable/sentry_files_archived

      # For upgrades from before snapshot-archiving, assume everything from the
      # snapshots -except the files still on the disk image- was already archived,
      # to avoid re-archiving things that were manually deleted from the archive
      # server.
      if [ ! -e "$sentrylist_previously_archived" ] && [ -d "$MUTABLE_MOUNTPOINT/TeslaCam" ]
      then
        find "$MUTABLE_MOUNTPOINT/TeslaCam" -name EncryptedClips -prune -o \
          -type l -printf '%P\n' | sort > "$TESLAUSB_SETUP_TMPDIR/allfiles.txt"
        find /mnt/cam/TeslaCam /mnt/cam/ -name EncryptedClips -prune -o \
          -type f -printf '%P\n' | sort > "$TESLAUSB_SETUP_TMPDIR/stilloncard.txt"
        comm -2 -3 "$TESLAUSB_SETUP_TMPDIR/allfiles.txt" "$TESLAUSB_SETUP_TMPDIR/stilloncard.txt" > "$sentrylist_previously_archived"
        rm -f -- "$TESLAUSB_SETUP_TMPDIR/allfiles.txt" "$TESLAUSB_SETUP_TMPDIR/stilloncard.txt"
      fi

      umount -l /mnt/cam || setup_progress "failed to unmount /mnt/cam"
    fi

    if [ -e /backingfiles/music_disk.bin ] && mount_with_retry /mnt/music
    then
      touch /mnt/music/.metadata_never_index
      umount -l /mnt/music || setup_progress "failed to unmount /mnt/music"
    fi

    if [ -e /backingfiles/lightshow_disk.bin ] && mount_with_retry /mnt/lightshow
    then
      mkdir -p /mnt/lightshow/LightShow
      touch /mnt/lightshow/.metadata_never_index
      umount -l /mnt/lightshow || setup_progress "failed to unmount /mnt/lightshow"
    fi

    if [ -e /backingfiles/boombox_disk.bin ] && mount_with_retry /mnt/boombox
    then
      mkdir -p /mnt/boombox/Boombox
      touch /mnt/boombox/.metadata_never_index
      umount -l /mnt/boombox || setup_progress "failed to unmount /mnt/boombox"
    fi

  else
    setup_progress "STOP: Couldn't check image"
    exit 1
  fi
}

function configure_hostname () {
  local new_host_name="$TESLAUSB_HOSTNAME"
  local old_host_name
  local hosts_tmp
  local hostname_tmp
  local hostname_attempt
  old_host_name=$(hostname)

  # Set the specified hostname if it differs from the current name
  if [ "$new_host_name" != "$old_host_name" ]
  then
    setup_progress "Configuring the hostname..."
    hosts_tmp="$(mktemp /etc/.hosts.XXXXXX)"
    hostname_tmp="$(mktemp /etc/.hostname.XXXXXX)"
    if ! awk -v old="$old_host_name" -v new="$new_host_name" '
      BEGIN { OFS="\t" }
      {
        for (i = 2; i <= NF; i++) {
          if (substr($i, 1, 1) == "#") break
          if ($i == old) $i = new
        }
        print
      }
    ' /etc/hosts > "$hosts_tmp" ||
       ! printf '%s\n' "$new_host_name" > "$hostname_tmp"
    then
      rm -f -- "$hosts_tmp" "$hostname_tmp"
      setup_progress "STOP: failed to stage hostname configuration"
      exit 1
    fi
    chown root:root "$hosts_tmp" "$hostname_tmp"
    chmod 0644 "$hosts_tmp" "$hostname_tmp"
    mv -fT -- "$hosts_tmp" /etc/hosts
    mv -fT -- "$hostname_tmp" /etc/hostname
    for hostname_attempt in {1..30}
    do
      if hostnamectl set-hostname "$new_host_name"
      then
        break
      fi
      if [ ! -e /lib/systemd/system/dbus.service ]
      then
        break
      fi
      if [ "$hostname_attempt" -eq 30 ]
      then
        setup_progress "STOP: hostnamectl failed after 30 attempts"
        exit 1
      fi
      setup_progress "hostnamectl failed, retrying"
      sleep 1
    done
    systemctl restart avahi-daemon || true
    setup_progress "Configured hostname: $(hostname)"
  fi
}

