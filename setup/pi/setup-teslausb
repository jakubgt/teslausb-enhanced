function cmd_upgrade {
  if [ ! -e /teslausb/TESLAUSB_SETUP_FINISHED ]
  then
    echo "STOP: previous setup didn't finish, can't upgrade unfinished install"
    exit 1
  fi
  export TESLAUSB_UPGRADE_DIR="$TESLAUSB_SETUP_TMPDIR/upgrade"
  mkdir -m 0700 "$TESLAUSB_UPGRADE_DIR"
  copy_script setup/pi/setup-teslausb "$TESLAUSB_UPGRADE_DIR" &> /dev/null
  copy_script setup/pi/envsetup.sh "$TESLAUSB_UPGRADE_DIR" &> /dev/null
  copy_script pi-gen-sources/00-teslausb-tweaks/files/teslausb-config-loader.sh \
    "$TESLAUSB_UPGRADE_DIR" &> /dev/null
  copy_script pi-gen-sources/00-teslausb-tweaks/files/teslausb_config.py \
    "$TESLAUSB_UPGRADE_DIR" &> /dev/null
  copy_script setup/pi/transactional-upgrade.sh "$TESLAUSB_UPGRADE_DIR" &> /dev/null

  export TESLAUSB_TRANSACTION_MANAGER="$TESLAUSB_UPGRADE_DIR/transactional-upgrade.sh"
  export TESLAUSB_CONFIG_HELPER="$TESLAUSB_UPGRADE_DIR/teslausb_config.py"
  TESLAUSB_UPGRADE_STAGING_DIR=$(
    "$TESLAUSB_TRANSACTION_MANAGER" prepare "$SOURCE_DIR"
  )
  export TESLAUSB_UPGRADE_STAGING_DIR
  "$TESLAUSB_TRANSACTION_MANAGER" stage-file "$TESLAUSB_UPGRADE_STAGING_DIR" \
    "$TESLAUSB_UPGRADE_DIR/setup-teslausb" setup-teslausb
  "$TESLAUSB_TRANSACTION_MANAGER" stage-file "$TESLAUSB_UPGRADE_STAGING_DIR" \
    "$TESLAUSB_UPGRADE_DIR/envsetup.sh" envsetup.sh
  "$TESLAUSB_TRANSACTION_MANAGER" stage-file "$TESLAUSB_UPGRADE_STAGING_DIR" \
    "$TESLAUSB_UPGRADE_DIR/teslausb-config-loader.sh" teslausb-config-loader.sh
  "$TESLAUSB_TRANSACTION_MANAGER" stage-file "$TESLAUSB_UPGRADE_STAGING_DIR" \
    "$TESLAUSB_UPGRADE_DIR/teslausb_config.py" teslausb_config.py
  "$TESLAUSB_TRANSACTION_MANAGER" stage-file "$TESLAUSB_UPGRADE_STAGING_DIR" \
    "$TESLAUSB_TRANSACTION_MANAGER" teslausb-upgrade

  exec bash -c '
    if TESLAUSB_TRANSACTIONAL_UPGRADE=1 \
         "$TESLAUSB_UPGRADE_DIR/setup-teslausb" upgrade_prepare &&
       TESLAUSB_TRANSACTIONAL_UPGRADE=1 NO_REBOOT_PROMPT=1 \
         "$TESLAUSB_UPGRADE_DIR/setup-teslausb" &&
       TESLAUSB_TRANSACTIONAL_UPGRADE=1 \
         "$TESLAUSB_UPGRADE_DIR/setup-teslausb" upgrade_finish
    then
      exit 0
    else
      upgrade_status=$?
      "$TESLAUSB_TRANSACTION_MANAGER" abort "$TESLAUSB_UPGRADE_STAGING_DIR" || true
      exit "$upgrade_status"
    fi
  '
}

function systemd_unit_load_state {
  local load_state
  local service_name="$1"
  if ! load_state=$(
    systemctl show "$service_name" --property=LoadState --value 2> /dev/null
  )
  then
    setup_progress "STOP: unable to inspect systemd service $service_name"
    return 1
  fi
  if [ -z "$load_state" ]
  then
    setup_progress "STOP: systemd returned no load state for $service_name"
    return 1
  fi
  printf '%s\n' "$load_state"
}

function stop_required_service_for_upgrade {
  local load_state
  local service_name="$1"
  load_state=$(systemd_unit_load_state "$service_name") || return 1
  if [ "$load_state" = not-found ]
  then
    setup_progress "STOP: required service is absent: $service_name"
    return 1
  fi
  systemctl stop "$service_name" || {
    setup_progress "STOP: could not stop required service $service_name"
    return 1
  }
  if systemctl is-active --quiet "$service_name"
  then
    setup_progress "STOP: required service remained active: $service_name"
    return 1
  fi
}

function stop_optional_service_for_upgrade {
  local load_state
  local service_name="$1"
  load_state=$(systemd_unit_load_state "$service_name") || return 1
  if [ "$load_state" = not-found ]
  then
    setup_progress "optional service is absent: $service_name"
    return 0
  fi
  systemctl stop "$service_name" || {
    setup_progress "STOP: could not stop installed optional service $service_name"
    return 1
  }
  if systemctl is-active --quiet "$service_name"
  then
    setup_progress "STOP: optional service remained active: $service_name"
    return 1
  fi
}

function gadget_is_prepared {
  local configfs_root
  if [ -d /sys/module/g_mass_storage ]
  then
    return 0
  fi
  configfs_root=$(findmnt -o TARGET -n configfs 2> /dev/null) || return 1
  [ -d "$configfs_root/usb_gadget/teslausb" ]
}

function disable_gadget_for_upgrade {
  local disable_output
  local disable_status=0
  if [ ! -x /root/bin/disable_gadget.sh ]
  then
    setup_progress 'STOP: /root/bin/disable_gadget.sh is unavailable'
    return 1
  fi
  if disable_output=$(/root/bin/disable_gadget.sh 2>&1)
  then
    disable_status=0
  else
    disable_status=$?
  fi
  if gadget_is_prepared
  then
    setup_progress "STOP: USB gadget remained prepared after disable attempt (status $disable_status): $disable_output"
    return 1
  fi
  # Exit 2 means the configfs gadget was already absent. Other non-zero exits
  # are safe only because the state check above proved no module/configfs
  # gadget still references a backing file.
  if [ "$disable_status" -ne 0 ] && [ "$disable_status" -ne 2 ]
  then
    setup_progress "USB gadget disable returned $disable_status after reaching a safe detached state: $disable_output"
  fi
}

function unmount_if_mounted_for_upgrade {
  local mount_path="$1"
  if [ ! -e "$mount_path" ] || ! mountpoint -q -- "$mount_path"
  then
    return 0
  fi
  umount -- "$mount_path" || {
    setup_progress "STOP: could not unmount $mount_path"
    return 1
  }
  if mountpoint -q -- "$mount_path"
  then
    setup_progress "STOP: mount remained active after unmount: $mount_path"
    return 1
  fi
}

function cmd_upgrade_prepare {
  local mount_path
  local -a snapshot_mounts=()
  setup_progress "preparing for full upgrade"
  (
    stop_required_service_for_upgrade teslausb.service
    stop_optional_service_for_upgrade smbd.service
    stop_optional_service_for_upgrade autofs.service
    disable_gadget_for_upgrade
    shopt -s nullglob
    snapshot_mounts=(/backingfiles/snapshots/snap*/mnt)
    shopt -u nullglob
    for mount_path in "${snapshot_mounts[@]}" /mnt/cam /mnt/music \
      /mnt/lightshow /mnt/boombox /mnt/archive /mnt/musicarchive
    do
      unmount_if_mounted_for_upgrade "$mount_path"
    done
    /root/bin/remountfs_rw
    if declare -F teslausb_secure_config > /dev/null
    then
      if [ -n "${TESLAUSB_CONFIG_PATH:-}" ]
      then
        teslausb_secure_config "$TESLAUSB_CONFIG_PATH"
      elif [ -e /root/teslausb_setup.json ]
      then
        teslausb_secure_config /root/teslausb_setup.json
      else
        teslausb_secure_config /root/teslausb_setup_variables.conf
      fi
    else
      secure_setup_config_file /root/teslausb_setup_variables.conf
    fi
    # a previous bookworm install may have the makers in /boot, so move
    # them to /teslausb (/boot/firmware)
    if [ ! /boot -ef /teslausb ]
    then
      for i in WIFI_ENABLED TESLAUSB_SETUP_STARTED TESLAUSB_SETUP_FINISHED
      do
        if [ -e "/boot/$i" ]
        then
          mv "/boot/$i" /teslausb
        fi
      done
    fi
  )
}

function cmd_upgrade_finish {
  if [ -z "${TESLAUSB_UPGRADE_DIR:-}" ] || [ -L "$TESLAUSB_UPGRADE_DIR" ] || \
     [ ! -f "$TESLAUSB_UPGRADE_DIR/setup-teslausb" ] || \
     [ ! -f "$TESLAUSB_UPGRADE_DIR/envsetup.sh" ] || \
     [ -z "${TESLAUSB_UPGRADE_STAGING_DIR:-}" ] || \
     [ -z "${TESLAUSB_TRANSACTION_MANAGER:-}" ] || \
     [ ! -x "$TESLAUSB_TRANSACTION_MANAGER" ]
  then
    setup_progress "STOP: the private upgrade staging directory is unavailable"
    exit 1
  fi
  "$TESLAUSB_TRANSACTION_MANAGER" stage-file "$TESLAUSB_UPGRADE_STAGING_DIR" \
    "$TESLAUSB_UPGRADE_DIR/setup-teslausb" setup-teslausb
  "$TESLAUSB_TRANSACTION_MANAGER" stage-file "$TESLAUSB_UPGRADE_STAGING_DIR" \
    "$TESLAUSB_UPGRADE_DIR/envsetup.sh" envsetup.sh
  "$TESLAUSB_TRANSACTION_MANAGER" stage-file "$TESLAUSB_UPGRADE_STAGING_DIR" \
    "$TESLAUSB_UPGRADE_DIR/teslausb-config-loader.sh" teslausb-config-loader.sh
  "$TESLAUSB_TRANSACTION_MANAGER" stage-file "$TESLAUSB_UPGRADE_STAGING_DIR" \
    "$TESLAUSB_UPGRADE_DIR/teslausb_config.py" teslausb_config.py
  "$TESLAUSB_TRANSACTION_MANAGER" stage-file "$TESLAUSB_UPGRADE_STAGING_DIR" \
    "$TESLAUSB_TRANSACTION_MANAGER" teslausb-upgrade
  # Full setup may have rewritten unit files after the recovery guard was
  # installed. Health checks must exercise the definitions that the next boot
  # will actually load.
  systemctl daemon-reload
  activated_release=$(
    "$TESLAUSB_TRANSACTION_MANAGER" finalize "$TESLAUSB_UPGRADE_STAGING_DIR"
  )
  setup_progress "upgrade finished; activated verified release $activated_release"
  for i in {5..1}
  do
    echo -e -n "rebooting in $i seconds to apply changes, press ctrl-c to abort\r"
    sleep 1
  done
  echo -e '\nRebooting'
  reboot
}

