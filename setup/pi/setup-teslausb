else
  setup_progress "updating rc.local"
  mv "$tmpdir/rc.local" /etc/rc.local
  parent=$(ps -o ppid= $PPID)
  grandparent=$(ps -o ppid= "$((parent))" )
  caller=$(ps -o comm= "$((grandparent))")
  if [ "$caller" = "rc.local" ] && [ ! -t 0 ]
  then
