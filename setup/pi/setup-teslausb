copy_script setup/pi/configure-automount.sh "$TESLAUSB_SCRIPT_TMPDIR"
"$TESLAUSB_SCRIPT_TMPDIR/configure-automount.sh"

copy_script setup/pi/configure-web.sh "$TESLAUSB_SCRIPT_TMPDIR"
